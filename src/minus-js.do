import { MinusClass, MinusFunction, MinusImport, MinusModule } from "./minus-ir"
import { classFieldOffset, classSize } from "./minus-layout"

function quoteJson(value: string): string {
    let result = "\""
    for index of 0..<value.length {
        character := value[index]
        code := int(character)
        if character == '"' { result = result + "\\\"" }
        else if character == '\\' { result = result + "\\\\" }
        else if code == 10 { result = result + "\\n" }
        else if code == 13 { result = result + "\\r" }
        else if code == 9 { result = result + "\\t" }
        else { result = result + value.substring(index, index + 1) }
    }
    return result + "\""
}

function classKind(class_: MinusClass): string {
    if class_.name == "__doof_string" { return "string" }
    if class_.name == "__doof_array_char" { return "char-array" }
    if class_.name == "__doof_array_byte" { return "byte-array" }
    return "class"
}

function classMetadata(class_: MinusClass, tag: int): string {
    let fields: string[] = []
    for index of 0..<class_.fields.length {
        field := class_.fields[index]
        fields.push("{name:" + quoteJson(field.name) + ",type:" + quoteJson(field.typeName) + ",offset:" + string(classFieldOffset(class_, index)) + "}")
    }
    let result = "{tag:" + string(tag) + ",name:" + quoteJson(class_.name) + ",kind:" + quoteJson(classKind(class_)) + ",size:" + string(classSize(class_)) + ",fields:["
    for index of 0..<fields.length {
        if index > 0 { result = result + "," }
        result = result + fields[index]
    }
    return result + "]}"
}

function exportMetadata(function_: MinusFunction): string {
    let params: string[] = []
    for param of function_.params { params.push(quoteJson(param.typeName)) }
    let list = "["
    for index of 0..<params.length {
        if index > 0 { list = list + "," }
        list = list + params[index]
    }
    return "{name:" + quoteJson(if function_.exportName == "" then function_.name else function_.exportName) + ",params:" + list + "],result:" + quoteJson(function_.result) + "}"
}

function importMetadata(import_: MinusImport): string {
    let params: string[] = []
    for param of import_.params { params.push(quoteJson(param.typeName)) }
    let list = "["
    for index of 0..<params.length {
        if index > 0 { list = list + "," }
        list = list + params[index]
    }
    return "{name:" + quoteJson(import_.name) + ",module:" + quoteJson(import_.importModule) + ",importName:" + quoteJson(import_.importName) + ",params:" + list + "],result:" + quoteJson(import_.result) + "}"
}

/** Render the standalone JavaScript FFI module and optional heap inspector. */
export function renderDoofJs(module_: MinusModule, debugHeap: bool = false): string {
    let classes: string[] = []
    for index of 0..<module_.classes.length { classes.push(classMetadata(module_.classes[index], 32 + index)) }
    let enums: string[] = []
    for index of 0..<module_.enums.length { enums.push("{tag:" + string(32 + module_.classes.length + index) + ",name:" + quoteJson(module_.enums[index].name) + "}") }
    let metadata = "["
    for index of 0..<classes.length {
        if index > 0 { metadata = metadata + "," }
        metadata = metadata + classes[index]
    }
    metadata = metadata + "]"
    let functionMetadata: string[] = []
    for function_ of module_.functions { if function_.exported { functionMetadata.push(exportMetadata(function_)) } }
    let functionList = "["
    for index of 0..<functionMetadata.length {
        if index > 0 { functionList = functionList + "," }
        functionList = functionList + functionMetadata[index]
    }
    functionList = functionList + "]"
    let importMetadataList: string[] = []
    for import_ of module_.imports { importMetadataList.push(importMetadata(import_)) }
    let importsList = "["
    for index of 0..<importMetadataList.length {
        if index > 0 { importsList = importsList + "," }
        importsList = importsList + importMetadataList[index]
    }
    importsList = importsList + "]"

    let result = "// Generated by doof-wasm.\n"
    result = result + "const classes = " + metadata + ";\n"
    result = result + "const classesByTag = new Map(classes.map(type => [type.tag, type]));\n"
    result = result + "const classesByName = new Map(classes.map(type => [type.name, type]));\n"
    let enumMetadata = "["
    for index of 0..<enums.length {
        if index > 0 { enumMetadata = enumMetadata + "," }
        enumMetadata = enumMetadata + enums[index]
    }
    enumMetadata = enumMetadata + "]"
    result = result + "const enumsByTag = new Map(" + enumMetadata + ".map(type => [type.tag, type]));\n"
    result = result + "const exportedFunctions = " + functionList + ";\n"
    result = result + "const importedFunctions = " + importsList + ";\n"
    result = result + "function createDoofModule(instance) {\n"
    result = result + "  const wasm = instance.exports || instance;\n"
    result = result + "  const memory = wasm.__doof_ffi_memory, alloc = wasm.__doof_ffi_alloc, release = wasm.__doof_ffi_release;\n"
    result = result + "  if (!memory || !alloc || !release) throw new Error('Doof FFI exports are missing');\n"
    result = result + "  const stringType = classesByName.get('__doof_string'), charArrayType = classesByName.get('__doof_array_char');\n"
    result = result + "  function makeString(text) { if (typeof text !== 'string') throw new TypeError('expected a string'); const chars = []; for (const char of text) { const code = char.codePointAt(0); if (code > 255) throw new RangeError('Doof strings support characters from 0 to 255'); chars.push(code); } if (chars.length > 1024) throw new RangeError('Doof strings are limited to 1024 characters'); if (!stringType || !charArrayType) throw new Error('this module has no string layout'); const dataSize = Math.max(24, 24 + Math.ceil(Math.max(0, chars.length - 16) / 16) * 16); const data = alloc(dataSize, 30) >>> 0; let view = new DataView(memory.buffer); view.setUint32(data + 4, chars.length, true); for (let i = 0; i < chars.length; i++) view.setUint8(data + 8 + i, chars[i]); const array = alloc(charArrayType.size, charArrayType.tag) >>> 0; view = new DataView(memory.buffer); view.setUint32(array + 4, 1, true); const dataField = charArrayType.fields.find(field => field.name === 'data'); view.setUint32(array + dataField.offset, data, true); const string = alloc(stringType.size, stringType.tag) >>> 0; view = new DataView(memory.buffer); view.setUint32(string + 4, 1, true); const charsField = stringType.fields.find(field => field.name === 'chars'); view.setUint32(string + charsField.offset, array, true); return string; }\n"
    result = result + "  function readString(address) { const view = new DataView(memory.buffer); const charsField = stringType.fields.find(field => field.name === 'chars'); const array = view.getUint32(address + charsField.offset, true); const arrayView = new DataView(memory.buffer); const dataField = charArrayType.fields.find(field => field.name === 'data'); const data = arrayView.getUint32(array + dataField.offset, true); const length = arrayView.getUint32(data + 4, true); const bytes = new Uint8Array(memory.buffer, data + 8, length); let text = ''; for (let i = 0; i < bytes.length; i += 8192) text += String.fromCharCode(...bytes.subarray(i, i + 8192)); return text; }\n"
    result = result + "  const api = Object.create(null); for (const fn of exportedFunctions) { const raw = wasm[fn.name]; if (typeof raw !== 'function') throw new Error('missing Wasm export: ' + fn.name); api[fn.name] = (...args) => { if (args.length !== fn.params.length) throw new TypeError(fn.name + ' expects ' + fn.params.length + ' arguments'); const owned = []; let resultPointer = 0; try { const marshaled = args.map((value, index) => { if (fn.params[index] === '__doof_string') { const pointer = makeString(value); owned.push(pointer); return pointer; } if (fn.params[index] === 'bool') return value ? 1 : 0; return value; }); const value = raw(...marshaled); if (fn.result === '__doof_string') { resultPointer = value >>> 0; return readString(resultPointer); } if (fn.result === 'bool') return value !== 0; return value; } finally { if (fn.result === '__doof_string' && resultPointer) release(resultPointer); for (const pointer of owned) release(pointer); } }; } return api;\n}\n"
    result = result + "export { createDoofModule };\n"
    result = result + "function createDoofImports(host = {}) {\n"
    result = result + "  let wasm = null; const imports = Object.create(null);\n"
    result = result + "  function runtime() { if (!wasm) throw new Error('attach the Doof instance before calling host imports'); return wasm; }\n"
    result = result + "  function readString(address) { const w = runtime(), memory = w.__doof_ffi_memory; const stringType = classesByName.get('__doof_string'), arrayType = classesByName.get('__doof_array_char'); const view = new DataView(memory.buffer); const chars = view.getUint32(address + stringType.fields.find(field => field.name === 'chars').offset, true); const data = view.getUint32(chars + arrayType.fields.find(field => field.name === 'data').offset, true); const length = view.getUint32(data + 4, true); const bytes = new Uint8Array(memory.buffer, data + 8, length); let text = ''; for (let i = 0; i < bytes.length; i += 8192) text += String.fromCharCode(...bytes.subarray(i, i + 8192)); return text; }\n"
    result = result + "  function makeString(text) { if (typeof text !== 'string') throw new TypeError('host import must return a string'); const chars = []; for (const char of text) { const code = char.codePointAt(0); if (code > 255) throw new RangeError('Doof strings support characters from 0 to 255'); chars.push(code); } if (chars.length > 1024) throw new RangeError('Doof strings are limited to 1024 characters'); const w = runtime(), memory = w.__doof_ffi_memory, alloc = w.__doof_ffi_alloc; const stringType = classesByName.get('__doof_string'), arrayType = classesByName.get('__doof_array_char'); const size = Math.max(24, 24 + Math.ceil(Math.max(0, chars.length - 16) / 16) * 16); const data = alloc(size, 30) >>> 0; let view = new DataView(memory.buffer); view.setUint32(data + 4, chars.length, true); for (let i = 0; i < chars.length; i++) view.setUint8(data + 8 + i, chars[i]); const array = alloc(arrayType.size, arrayType.tag) >>> 0; view = new DataView(memory.buffer); view.setUint32(array + 4, 1, true); view.setUint32(array + arrayType.fields.find(field => field.name === 'data').offset, data, true); const string = alloc(stringType.size, stringType.tag) >>> 0; view = new DataView(memory.buffer); view.setUint32(string + 4, 1, true); view.setUint32(string + stringType.fields.find(field => field.name === 'chars').offset, array, true); return string; }\n"
    result = result + "  for (const fn of importedFunctions) { const callback = fn.module === 'doof' ? host[fn.importName] : host[fn.module]?.[fn.importName]; if (typeof callback !== 'function') throw new TypeError('missing host function ' + fn.module + '.' + fn.importName); if (!imports[fn.module]) imports[fn.module] = Object.create(null); imports[fn.module][fn.importName] = (...args) => { if (args.length !== fn.params.length) throw new TypeError(fn.importName + ' expects ' + fn.params.length + ' arguments'); const converted = args.map((value, index) => fn.params[index] === '__doof_string' ? readString(value >>> 0) : fn.params[index] === 'bool' ? value !== 0 : value); const value = callback(...converted); if (fn.result === '__doof_string') return makeString(value); if (fn.result === 'bool') return value ? 1 : 0; return value; }; }\n"
    result = result + "  return {imports, attach(instance) { wasm = instance.exports || instance; }};\n}\n"
    result = result + "export { createDoofImports };\n"
    if !debugHeap { return result }
    result = result + "const primitiveTags = ['none','bool','char','byte','short','int','long','float','double'];\n"
    result = result + "function createDoofHeapInspector(instance) {\n"
    result = result + "  const exports = instance.exports || instance;\n"
    result = result + "  const memory = exports.__doof_ffi_memory;\n"
    result = result + "  const heapEnd = exports.__doof_debug_heap_end;\n"
    result = result + "  if (!memory || !heapEnd) throw new Error('debug heap exports are missing; compile with --debug-heap');\n"
    result = result + "  function view() { return new DataView(memory.buffer); }\n"
    result = result + "  function readValue(type, address) {\n"
    result = result + "    const v = view();\n"
    result = result + "    switch (type) {\n"
    result = result + "      case 'bool': return v.getUint8(address) !== 0;\n"
    result = result + "      case 'byte': case 'char': return v.getUint8(address);\n"
    result = result + "      case 'short': return v.getInt16(address, true);\n"
    result = result + "      case 'int': case 'any': return v.getInt32(address, true);\n"
    result = result + "      case 'long': return v.getBigInt64(address, true);\n"
    result = result + "      case 'float': return v.getFloat32(address, true);\n"
    result = result + "      case 'double': return v.getFloat64(address, true);\n"
    result = result + "      default: return v.getUint32(address, true);\n"
    result = result + "    }\n  }\n"
    result = result + "  function inspectBlock(address) {\n"
    result = result + "    const v = view();\n    const end = heapEnd.value >>> 0;\n"
    result = result + "    if (!Number.isInteger(address) || address < 1024 || address + 4 > end) throw new RangeError('address is outside the allocated heap');\n"
    result = result + "    const tag = v.getUint16(address, true), size = v.getUint16(address + 2, true);\n"
    result = result + "    if (size < 4 || address + size > end) throw new Error('invalid heap block header at ' + address);\n"
    result = result + "    if (tag === 0) return {address, size, kind:'free', nextFree:v.getUint32(address + 4, true)};\n"
    result = result + "    if (tag === 30) { const length = v.getUint32(address + 4, true); return {address, size, kind:'array-data', length, values:Array.from(new Uint8Array(memory.buffer, address + 8, Math.min(length, Math.max(0, size - 8))))}; }\n"
    result = result + "    if (tag === 31) { const valueTag = v.getUint16(address + 8, true); const name = primitiveTags[valueTag] || classesByTag.get(valueTag)?.name || enumsByTag.get(valueTag)?.name || ('tag-' + valueTag); const value = valueTag === 0 ? null : readValue(name, address + 16); return {address, size, kind:'any', refCount:v.getUint32(address + 4, true), valueTag, valueType:name, value}; }\n"
    result = result + "    const type = classesByTag.get(tag);\n    if (!type) return {address, size, kind:'unknown', tag};\n"
    result = result + "    const fields = Object.create(null);\n    for (const field of type.fields) fields[field.name] = field.type === 'none' ? null : readValue(field.type, address + field.offset);\n"
    result = result + "    const object = {address, size, kind:type.kind, type:type.name, refCount:v.getUint32(address + 4, true), fields};\n"
    result = result + "    if (type.kind === 'byte-array' || type.kind === 'char-array') { const data = fields.data >>> 0; const raw = inspectBlock(data); object.length = raw.length; if (type.kind === 'char-array') { let text = ''; for (let i = 0; i < raw.values.length; i += 8192) text += String.fromCharCode(...raw.values.slice(i, i + 8192)); object.value = text; } else object.value = raw.values; }\n"
    result = result + "    if (type.kind === 'string') { const chars = fields.chars >>> 0; object.value = inspectBlock(chars).value; object.length = object.value.length; }\n"
    result = result + "    return object;\n  }\n"
    result = result + "  function dumpHeap() {\n    const end = heapEnd.value >>> 0;\n    const blocks = [];\n    for (let address = 1024; address < end;) { const block = inspectBlock(address); blocks.push(block); if (!Number.isInteger(block.size) || block.size < 4) throw new Error('invalid heap block size at ' + address); address += block.size; }\n    return blocks;\n  }\n"
    result = result + "  return {inspectBlock, dumpHeap};\n}\n"
    result = result + "export { createDoofHeapInspector };\n"
    return result
}
